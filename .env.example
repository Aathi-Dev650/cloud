DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-single-page-application-client-id
AUTH0_AUDIENCE=https://api.cropcure.local
AUTH0_CALLBACK_URL=http://127.0.0.1:8000/
AUTH0_LOGOUT_URL=http://127.0.0.1:8000/

GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE=(default)

DROPBOX_ACCESS_TOKEN=your-dropbox-access-token
DROPBOX_ROOT=/CropCure

DISEASE_MODEL_PATH=ml/artifacts/disease_model.keras
DISEASE_LABELS_PATH=ml/artifacts/class_names.json
DISEASE_MIN_CONFIDENCE=0.60
